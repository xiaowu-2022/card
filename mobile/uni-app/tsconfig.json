{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "strict": true,
    "jsx": "preserve", "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "noEmit": true, "lib": ["ES2020", "DOM"], "types": ["@dcloudio/types", "vite/client", "node"],
    "baseUrl": ".", "paths": {"@/*": ["src/*"]}
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "vite.config.ts"]
}
