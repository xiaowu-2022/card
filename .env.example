APP_NAME="Aperture Cards"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://a.localhost:8000

PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_ADMIN_HOST=admin.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=card_platform
DB_USERNAME=card_platform
DB_PASSWORD=local-development-only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
USER_OTP_TTL_MINUTES=10
USER_OTP_MAX_ATTEMPTS=5
USER_OTP_VERIFY_LIMIT_PER_MINUTE=5
USER_OTP_RESEND_COOLDOWN_SECONDS=60
USER_OTP_SEND_LIMIT_PER_HOUR=6
USER_LOGIN_MAX_ATTEMPTS=5

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private
KYC_IDENTITY_HASH_KEY=
KYC_OCR_DRIVER=mock
KYC_MOCK_OCR_MODE=SUCCESS
KYC_DOCUMENT_DISK=private
KYC_DOCUMENT_MAX_MB=10
KYC_DOCUMENT_ACCESS_TTL_SECONDS=300
KYC_ADMIN_RECENT_AUTH_TTL_SECONDS=900

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.test"
MAIL_FROM_NAME="${APP_NAME}"

CARD_PROVIDER_DRIVER=mock
MOCK_CARD_PROVIDER_MODE=SUCCESS

VITE_APP_NAME="${APP_NAME}"
