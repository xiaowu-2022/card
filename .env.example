APP_NAME="Aperture Cards"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://a.localhost:8000

PLATFORM_ROOT_DOMAIN=localhost
PLATFORM_ADMIN_HOST=admin.localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=card_platform
DB_USERNAME=card_platform
DB_PASSWORD=local-development-only

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@example.test"
MAIL_FROM_NAME="${APP_NAME}"

CARD_PROVIDER_DRIVER=mock
MOCK_CARD_PROVIDER_MODE=SUCCESS

VITE_APP_NAME="${APP_NAME}"
