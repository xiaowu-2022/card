<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing" force="true"/>
        <server name="DB_DATABASE" value="card_ui_test" force="true"/>
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="CARD_PROVIDER_DRIVER" value="mock" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_HOST" value="postgres"/>
        <env name="DB_PORT" value="5432"/>
        <env name="DB_DATABASE" value="card_ui_test" force="true"/>
        <env name="DB_USERNAME" value="card_platform"/>
        <env name="DB_PASSWORD" value="local-development-only"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="KYC_IDENTITY_HASH_KEY" value="testing-only-kyc-identity-hmac-key-32-bytes"/>
        <env name="KYC_DATA_ENCRYPTION_KEY" value="base64:ZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGRkZGQ="/>
        <env name="WITHDRAWAL_ADDRESS_ENCRYPTION_KEY" value="base64:ZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWVlZWU="/>
        <env name="WITHDRAWAL_ADDRESS_HASH_KEY" value="base64:ZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmZmY="/>
        <env name="BLOCKCHAIN_GATEWAY_DRIVER" value="mock"/>
        <env name="TRON_USDT_DEPOSIT_ADDRESS" value="T111111111111111111111111111111111"/>
        <env name="TRON_USDT_TOKEN_CONTRACT" value="T222222222222222222222222222222222"/>
        <env name="TRON_TOPUP_VALIDITY_MINUTES" value="30"/>
        <env name="TRON_TOPUP_REQUIRED_CONFIRMATIONS" value="20"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
