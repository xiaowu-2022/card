# Deployment template only; never overwrite an existing .env.
# Copy persistent keys from the corresponding database backup; NEVER regenerate them.
APP_NAME="Aperture Cards"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.replace-me.invalid

PLATFORM_ROOT_DOMAIN=replace-me.invalid
PLATFORM_ADMIN_HOST=admin.replace-me.invalid

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_TIMEZONE=UTC

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=card_production
DB_USERNAME=card_runtime
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
USER_OTP_TTL_MINUTES=10
USER_OTP_MAX_ATTEMPTS=5
USER_OTP_VERIFY_LIMIT_PER_MINUTE=5
USER_OTP_RESEND_COOLDOWN_SECONDS=60
USER_OTP_SEND_LIMIT_PER_HOUR=6
USER_LOGIN_MAX_ATTEMPTS=5

CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

FILESYSTEM_DISK=local
PRIVATE_FILESYSTEM_DISK=private
KYC_DATA_ENCRYPTION_KEY=
WITHDRAWAL_ADDRESS_ENCRYPTION_KEY=
WITHDRAWAL_ADDRESS_HASH_KEY=
BLOCKCHAIN_GATEWAY_DRIVER=unavailable
# Real incoming USDT only: set driver to trongrid; no withdrawal verification is enabled.
# Encrypt the TronGrid API key with the application's Crypt service; never paste a plaintext key here.
TRONGRID_API_KEY_ENCRYPTED=
# Explicitly enable only after configuring the start time and reviewing the deployment runbook.
TRON_TOPUP_SCAN_ENABLED=false
TRON_TOPUP_SCAN_START_AT=
TRON_USDT_DEPOSIT_ADDRESS=
TRON_USDT_TOKEN_CONTRACT=
TRON_TOPUP_VALIDITY_MINUTES=30
TRON_TOPUP_REQUIRED_CONFIRMATIONS=20
KYC_IDENTITY_HASH_KEY=
KYC_OCR_DRIVER=unavailable
KYC_MOCK_OCR_MODE=
KYC_DOCUMENT_DISK=private
KYC_DOCUMENT_MAX_MB=10
KYC_DOCUMENT_ACCESS_TTL_SECONDS=300
KYC_DOCUMENT_ACCESS_RATE_LIMIT_PER_MINUTE=30
KYC_ADMIN_RECENT_AUTH_TTL_SECONDS=900

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

CARD_PROVIDER_DRIVER=directory
# Local card simulation requires APP_ENV=local and an isolated card_mock/card_ui_test DB.
# Local use: docker compose up -d app deposit-refunds (unified port 8000).
# See docs/architecture/LOCAL_CARD_SIMULATION.md. No fallback from PhotonPay is enabled.

PHOTONPAY_BASE_URL=
PHOTONPAY_APP_ID=
PHOTONPAY_APP_SECRET=
PHOTONPAY_PRIVATE_KEY=
PHOTONPAY_USD_ACCOUNT_ID=
PHOTONPAY_MEMBER_ID=
PHOTONPAY_MATRIX_ACCOUNT=
PHOTONPAY_TIMEOUT_SECONDS=20

PAYMENT_PROVIDER_DRIVER=unavailable
PAYMENT_PROVIDER_MOCK_MODE=
PAYMENT_PROVIDER_MOCK_WEBHOOK_SECRET=
PAYMENT_INITIATION_LEASE_SECONDS=120
PAYMENT_INITIATION_RECOVERY_AFTER_SECONDS=30
PAYMENT_TOPUP_RATE_LIMIT_PER_MINUTE=10
PAYMENT_WEBHOOK_MAX_BYTES=65536
PAYMENT_CHECKOUT_HOSTS=
PAYMENT_UNKNOWN_AFTER_MINUTES=5
PAYMENT_RECOVERY_BATCH_SIZE=100

VITE_APP_NAME="${APP_NAME}"

SESSION_SECURE_COOKIE=true
DB_URL=
USER_OTP_SECRET=
LOCAL_VERIFIED_DOMAINS=
PHOTONPAY_WEBHOOK_PUBLIC_KEY=
